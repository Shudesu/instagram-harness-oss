#!/bin/bash
# Pre-push hook: scan staged files for secrets before pushing
# Install: git config core.hooksPath .githooks

SECRETS=(
  "37f8f88be4c099329e4647bda211bb9f"
  "c40947ff58a767be74a53be79a89d68a"
  "b2712617-31c4-47c2-accd-4eec906c44ce"
  "7efe7c20-01ae-4d65-be08-0d7b4202e8a1"
  "aiagent\.mini@gmail\.com"
)

# Files that are allowed to contain secrets (not synced to OSS)
SAFE_PATTERNS="CLAUDE\.md|\.mcp\.json|\.env|\.env\.|settings\.local\.json"

echo "🔍 Pre-push: scanning for secrets..."

FOUND=0
for secret in "${SECRETS[@]}"; do
  # Search all tracked files for the secret, excluding safe files
  MATCHES=$(git diff HEAD --name-only 2>/dev/null | while read file; do
    if [[ -f "$file" ]] && ! echo "$file" | grep -qE "$SAFE_PATTERNS"; then
      if grep -l "$secret" "$file" 2>/dev/null; then
        echo "$file"
      fi
    fi
  done)

  if [ -n "$MATCHES" ]; then
    echo "❌ SECRET DETECTED: $secret"
    echo "   in: $MATCHES"
    FOUND=1
  fi
done

if [ $FOUND -eq 1 ]; then
  echo ""
  echo "🚫 Push blocked. Remove secrets from the files above."
  echo "   Allowed files: CLAUDE.md, .mcp.json, .env*"
  exit 1
fi

echo "✅ No secrets found. Pushing..."
exit 0
